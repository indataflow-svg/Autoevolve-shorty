    {"id":"authT","type":"text","x":666,"y":255,"width":228,"height":120,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":17,"version":1,"versionNonce":17,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Dashboard / API\nHTTP Basic authentication\nDASHBOARD_USER + PASSWORD\nconstant-time compare\n\nAll company, sales, marketing,\nsetup & ops routers protected","fontSize":15,"fontFamily":2,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"Dashboard / API\nHTTP Basic authentication\nDASHBOARD_USER + PASSWORD\nconstant-time compare\n\nAll company, sales, marketing,\nsetup & ops routers protected","lineHeight":1.25},
