    {"id":"sqliteT","type":"text","x":130,"y":1208,"width":380,"height":215,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":30,"version":1,"versionNonce":30,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"SQLite — data/company.db\n\nLeads, companies, contacts, enrichment\nDrafts, delivery/reply events, suppression\nCampaigns, posts, assets, attribution\nTasks, incidents, orgs/accounts/capabilities\nSettings + state/history\n\nOperational limit: run one app process\nwhen using SQLite. Back up and test restore.","fontSize":16,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"SQLite — data/company.db\n\nLeads, companies, contacts, enrichment\nDrafts, delivery/reply events, suppression\nCampaigns, posts, assets, attribution\nTasks, incidents, orgs/accounts/capabilities\nSettings + state/history\n\nOperational limit: run one app process\nwhen using SQLite. Back up and test restore.","lineHeight":1.25},
