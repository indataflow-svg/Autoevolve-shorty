    {"id":"sub","type":"text","x":82,"y":98,"width":1770,"height":28,"angle":0,"strokeColor":"#5b616e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":2,"version":1,"versionNonce":2,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Solid arrows = data/action flow · dashed arrows = callback/event · red notes = stop / reject / exceptional behavior · all runtime state is local SQLite unless explicitly sent to a provider","fontSize":16,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Solid arrows = data/action flow · dashed arrows = callback/event · red notes = stop / reject / exceptional behavior · all runtime state is local SQLite unless explicitly sent to a provider","lineHeight":1.25},

