    {"id":"actionT","type":"text","x":965,"y":255,"width":240,"height":120,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":19,"version":1,"versionNonce":19,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Mutating operator-action gate\nX-Founder-Action-Token\n= SALES_ACTION_TOKEN\n\nRequired for resolving, draft\nchange/approve/send, suppress,\nsetup writes, research & actions","fontSize":15,"fontFamily":2,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"Mutating operator-action gate\nX-Founder-Action-Token\n= SALES_ACTION_TOKEN\n\nRequired for resolving, draft\nchange/approve/send, suppress,\nsetup writes, research & actions","lineHeight":1.25},
    {"id":"sales","type":"rectangle","x":1260,"y":240,"width":320,"height":300,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#d0ebff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":20,"version":1,"versionNonce":20,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":{"type":3},"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"salesT","type":"text","x":1278,"y":258,"width":285,"height":265,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":21,"version":1,"versionNonce":21,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Sales service\n\nIntake upsert + attribution passthrough\nCompany/contact resolution (cached)\nEnrichment / qualification\nModel-backed editable draft\nDraft → human edit → approve → send\nResend delivery/reply ingest\nMeeting / follow-up / suppression\n\nforce=true consumes another provider credit\nNo bulk send (doctor declares it)","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Sales service\n\nIntake upsert + attribution passthrough\nCompany/contact resolution (cached)\nEnrichment / qualification\nModel-backed editable draft\nDraft → human edit → approve → send\nResend delivery/reply ingest\nMeeting / follow-up / suppression\n\nforce=true consumes another provider credit\nNo bulk send (doctor declares it)","lineHeight":1.25},
    {"id":"marketing","type":"rectangle","x":1620,"y":240,"width":330,"height":300,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#d0ebff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":22,"version":1,"versionNonce":22,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":{"type":3},"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"marketingT","type":"text","x":1638,"y":258,"width":295,"height":265,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":23,"version":1,"versionNonce":23,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Marketing orchestration\n\nCampaign + manual-post APIs\nPer-org capabilities/accounts\nG1 content package & claim validation\nG2 asset search, voice, FFmpeg render\nVariant choice / assets / captions\nG3 R2 upload + Buffer draft only\nTracks campaign_id, post_id, UTM\n\nCampaign pending review: approve or\nregenerate — retry is rejected","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Marketing orchestration\n\nCampaign + manual-post APIs\nPer-org capabilities/accounts\nG1 content package & claim validation\nG2 asset search, voice, FFmpeg render\nVariant choice / assets / captions\nG3 R2 upload + Buffer draft only\nTracks campaign_id, post_id, UTM\n\nCampaign pending review: approve or\nregenerate — retry is rejected","lineHeight":1.25},
    {"id":"ops","type":"rectangle","x":1990,"y":240,"width":350,"height":300,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#d0ebff","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":24,"version":1,"versionNonce":24,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":{"type":3},"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"opsT","type":"text","x":2008,"y":258,"width":315,"height":265,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":25,"version":1,"versionNonce":25,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Operations / coding / monitoring\n\nTask queue + project workspaces\nOptional OpenHands coding gateway\nService monitor → incidents\nUnified queues, direct actions, history\n\nAccess model: private operator routes;\nproduction guidance adds IAP/reverse proxy,\nTLS, service-account file permissions and\nlog rotation / disk limits","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Operations / coding / monitoring\n\nTask queue + project workspaces\nOptional OpenHands coding gateway\nService monitor → incidents\nUnified queues, direct actions, history\n\nAccess model: private operator routes;\nproduction guidance adds IAP/reverse proxy,\nTLS, service-account file permissions and\nlog rotation / disk limits","lineHeight":1.25},
    {"id":"guard","type":"text","x":650,"y":610,"width":1660,"height":310,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":26,"version":1,"versionNonce":26,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Control gates and stopping conditions\n1. Provider calls are optional and scoped by feature; missing key does not prevent dashboard / health / docs startup.\n2. External data is never a license to send: generated model output is a draft, and email approval + sending are separate actions.\n3. A lead in suppressed state cannot be enriched or receive outreach. Bounce / reply / unsubscribe / meeting stop the follow-up path.\n4. Automatic contact is disabled by default (SALES_AUTO_CONTACT_ENABLED=false); only enable after sender configuration and consent review.\n5. G1 validates against approved knowledge/claims and prohibited claims; G2 cannot proceed while a G1 package requires founder approval.\n6. G3 is deliberately draft-only: a human approves in Buffer before publishing. R2 upload is verified as externally readable.\n7. Secrets are environment values; setup reads never return secret values. Use distinct intake, action and webhook secrets; rotate any exposed secret.","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Control gates and stopping conditions\n1. Provider calls are optional and scoped by feature; missing key does not prevent dashboard / health / docs startup.\n2. External data is never a license to send: generated model output is a draft, and email approval + sending are separate actions.\n3. A lead in suppressed state cannot be enriched or receive outreach. Bounce / reply / unsubscribe / meeting stop the follow-up path.\n4. Automatic contact is disabled by default (SALES_AUTO_CONTACT_ENABLED=false); only enable after sender configuration and consent review.\n5. G1 validates against approved knowledge/claims and prohibited claims; G2 cannot proceed while a G1 package requires founder approval.\n6. G3 is deliberately draft-only: a human approves in Buffer before publishing. R2 upload is verified as externally readable.\n7. Secrets are environment values; setup reads never return secret values. Use distinct intake, action and webhook secrets; rotate any exposed secret.","lineHeight":1.25},

