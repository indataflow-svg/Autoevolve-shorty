    {"id":"projectsT","type":"text","x":600,"y":1208,"width":360,"height":215,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":32,"version":1,"versionNonce":32,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"projects/ campaign workspaces\n\nG1 package + approved package\nG2 source assets, manifests, renders\nVoice handoff / selected variant\nCampaign event history\n\nTreat as private runtime data. Generated\nmedia, provider payloads and conversations\nare excluded from Git.","fontSize":16,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"projects/ campaign workspaces\n\nG1 package + approved package\nG2 source assets, manifests, renders\nVoice handoff / selected variant\nCampaign event history\n\nTreat as private runtime data. Generated\nmedia, provider payloads and conversations\nare excluded from Git.","lineHeight":1.25},
    {"id":"env","type":"rectangle","x":1030,"y":1190,"width":390,"height":250,"angle":0,"strokeColor":"#2b8a3e","backgroundColor":"#d3f9d8","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":33,"version":1,"versionNonce":33,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":{"type":3},"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"envT","type":"text","x":1050,"y":1208,"width":355,"height":215,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":34,"version":1,"versionNonce":34,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":".env + engine config\n\nDashboard/action/intake/webhook secrets\nProvider API keys and model routes\nBrand and sender configuration\nG3 Buffer/R2 configuration\n\nNever commit. Service-account readable only.\nBack up securely; rotate leaked values.","fontSize":16,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":".env + engine config\n\nDashboard/action/intake/webhook secrets\nProvider API keys and model routes\nBrand and sender configuration\nG3 Buffer/R2 configuration\n\nNever commit. Service-account readable only.\nBack up securely; rotate leaked values.","lineHeight":1.25},
    {"id":"knowledge","type":"rectangle","x":1470,"y":1190,"width":390,"height":250,"angle":0,"strokeColor":"#2b8a3e","backgroundColor":"#d3f9d8","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":35,"version":1,"versionNonce":35,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":{"type":3},"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"knowledgeT","type":"text","x":1490,"y":1208,"width":350,"height":215,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":36,"version":1,"versionNonce":36,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"G1 knowledge source of truth\n\nBrand profile, ICP, narratives\nProduct claims, approved exemplars\nCTA registry, platform rules\nProhibited claims\n\nOperator must replace examples and verify\napproved facts before publishable media.","fontSize":16,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"G1 knowledge source of truth\n\nBrand profile, ICP, narratives\nProduct claims, approved exemplars\nCTA registry, platform rules\nProhibited claims\n\nOperator must replace examples and verify\napproved facts before publishable media.","lineHeight":1.25},
    {"id":"retention","type":"text","x":110,"y":1500,"width":1720,"height":180,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":37,"version":1,"versionNonce":37,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Data governance boundary: lead/email records may be personal data. Operators—not the software—own lawful collection, consent, retention, deletion, suppression and provider compliance. Never put real lead payloads in public issues, fixtures, screenshots or logs. Repository guidance excludes .env, SQLite, generated media, provider payloads, contact exports and agent history from Git.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Data governance boundary: lead/email records may be personal data. Operators—not the software—own lawful collection, consent, retention, deletion, suppression and provider compliance. Never put real lead payloads in public issues, fixtures, screenshots or logs. Repository guidance excludes .env, SQLite, generated media, provider payloads, contact exports and agent history from Git.","lineHeight":1.25},

