    {"id":"callbackT","type":"text","x":330,"y":527,"width":180,"height":108,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":12,"version":1,"versionNonce":12,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Callbacks / events\nResend delivery + replies\nTally webhook\nExternal email routing","fontSize":16,"fontFamily":2,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"Callbacks / events\nResend delivery + replies\nTally webhook\nExternal email routing","lineHeight":1.25},
    {"id":"publicRisk","type":"text","x":90,"y":705,"width":435,"height":290,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":13,"version":1,"versionNonce":13,"isDeleted":false,"groupIds":[],"frameId":null,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Public-entry limits / edge cases\n• Do not put SALES_INTAKE_SECRET in browser JS; use your serverless/backend relay.\n• Intake requires email OR phone; Pydantic size caps constrain fields.\n• Tally: intake secret + optional HMAC over raw body.\n• Email worker: separate SALES_EMAIL_WEBHOOK_SECRET.\n• Resend: Svix HMAC, raw body, id/timestamp/signature required; stale timestamps rejected.\n• Add TLS, reverse-proxy / IAP and rate limits outside the app.\n• Provider configuration missing? dashboard stays available; feature reports disabled/not configured.","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Public-entry limits / edge cases\n• Do not put SALES_INTAKE_SECRET in browser JS; use your serverless/backend relay.\n• Intake requires email OR phone; Pydantic size caps constrain fields.\n• Tally: intake secret + optional HMAC over raw body.\n• Email worker: separate SALES_EMAIL_WEBHOOK_SECRET.\n• Resend: Svix HMAC, raw body, id/timestamp/signature required; stale timestamps rejected.\n• Add TLS, reverse-proxy / IAP and rate limits outside the app.\n• Provider configuration missing? dashboard stays available; feature reports disabled/not configured.","lineHeight":1.25},

