# Buffer accounts. Tokens are per Buffer user: get each one at
# https://publish.buffer.com/account/api while logged in as that user.
# The unprefixed block is the "default" account used by the dashboard.
export BUFFER_API_KEY=""
export BUFFER_ORGANIZATION_ID=""
export BUFFER_INSTAGRAM_CHANNEL_ID=""
export BUFFER_X_CHANNEL_ID=""

# Extra accounts: copy the block below, replacing ACME with a short
# lowercase name (letters, digits, - or _). The dashboard shows an account
# picker on every manual post; the G3 CLI takes --account <name>.
# Find channel IDs with: company-core-g3 --account acme channels
# export BUFFER_ACME_API_KEY=""
# export BUFFER_ACME_ORGANIZATION_ID=""
# export BUFFER_ACME_INSTAGRAM_CHANNEL_ID=""
# export BUFFER_ACME_X_CHANNEL_ID=""

# Cloudflare R2 S3 credentials and permanent public media origin.
export R2_ACCOUNT_ID=""
export R2_ACCESS_KEY_ID=""
export R2_SECRET_ACCESS_KEY=""
export R2_BUCKET="company-core-social-media"
export R2_PUBLIC_BASE_URL="https://media.example.com"
