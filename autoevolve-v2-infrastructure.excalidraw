   "locked": false,
   "text": "Solid arrows = data and action flow. Dashed arrows = scheduled jobs, remote spawns and signed callbacks. Red panels = stop and reject conditions. Green panels = new in V2. All runtime state is local SQLite unless\nexplicitly sent to a provider.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Solid arrows = data and action flow. Dashed arrows = scheduled jobs, remote spawns and signed callbacks. Red panels = stop and reject conditions. Green panels = new in V2. All runtime state is local SQLite unless\nexplicitly sent to a provider.",
   "lineHeight": 1.25,
   "autoResize": true
  },
