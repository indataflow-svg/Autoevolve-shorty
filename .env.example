# Company identity
COMPANY_NAME=Example Company
COMPANY_PUBLIC_URL=http://localhost:8787
# Empty = the hosted contact form (COMPANY_PUBLIC_URL/f/contact).
COMPANY_FORMS_URL=
COMPANY_BRAND_LOGO_URL=http://localhost:8787/static/company-core-logo.svg

# Dashboard authentication. scripts/init_env.sh replaces these placeholders.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=GENERATE_ME
SALES_ACTION_TOKEN=GENERATE_ME
SALES_INTAKE_SECRET=GENERATE_ME
SALES_EMAIL_WEBHOOK_SECRET=GENERATE_ME

# Website accounts. Signup creates one free organization per verified email.
# Verification mail falls back to the Resend key/domain below when the AUTH_*
# values are blank. Set AUTH_VERIFY_BASE_URL to the public website origin.
AUTH_SIGNUP_ENABLED=true
# Public website/auth host, not the app subdomain. Use a fragment link:
# https://example.com/verify#token=...
AUTH_VERIFY_BASE_URL=http://localhost:4181/verify
AUTH_COOKIE_NAME=autoevolve_session
# Production: example.com and __Secure-autoevolve_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Browser/API origins allowed to mutate with a session cookie.
# Production: https://example.com,https://app.example.com
AUTH_ALLOWED_ORIGINS=
AUTH_EXPOSE_DEV_TOKEN=false
AUTH_RESEND_API_KEY=
AUTH_FROM_NAME=AutoEvolve
AUTH_FROM_EMAIL=
AUTH_RESEND_DOMAIN=

# Stable key for encrypting per-organization publisher secrets at rest.
# scripts/init_env.sh replaces GENERATE_ME. Rotating it makes old secrets
# unreadable, so rotate only with a migration/re-entry plan.
APP_ENCRYPTION_KEY=GENERATE_ME

# Outbound send safety. Resend retains idempotency keys for 24 hours; a
# stranded send older than this window is parked in send_unknown for operator
# reconciliation instead of being retried automatically.
SALES_SEND_RECONCILE_ON_STARTUP=true
SALES_SEND_RECONCILE_WINDOW_SECONDS=86400

# In-app rate limits per client IP (60 second window). Keep the reverse-proxy
# limits from docs/production-checklist.md as the outer layer.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_INTAKE_PER_MINUTE=30
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=10
RATE_LIMIT_PUBLIC_AUTH_PER_MINUTE=20
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=false

# OpenAI-compatible model router (OmniRoute, Ollama, LiteLLM, or another gateway).
# REQUIRED for any AI action (drafts, research, briefs). Dashboard, /health and
# /docs start without it, but AI features return a clear "not configured" error.
# Where to get it: see docs/keys.md and docs/model-routing.md.
#  - OmniRoute: http://127.0.0.1:20128/v1 + Endpoints key from the OmniRoute dashboard.
#  - Ollama (fully local): http://127.0.0.1:11434/v1 + OMNIROUTE_API_KEY=ollama,
#    and set every MODEL_* to a real `ollama list` name (auto/* aliases do NOT work).
# Verify: curl $OMNIROUTE_BASE_URL/models -H "Authorization: Bearer $OMNIROUTE_API_KEY"
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
MODEL_FAST=auto/best-fast
MODEL_REASONING=auto/best-reasoning
MODEL_FREE=auto/best-free
MODEL_CODING=auto/best-coding
MODEL_VISION=auto/best-vision

# Optional coding agent. REQUIRED only for /operations coding + code_chat.py.
# Same gateway as above in most installs. Verify: same /models curl with CODING_* values.
CODING_BASE_URL=http://127.0.0.1:20128/v1
CODING_API_KEY=
CODING_DEFAULT_MODEL=auto/best-coding
CODING_MAX_REPAIR_CYCLES=3
CODING_COMPACT_AFTER_TASKS=6

# Publishing engine. Buffer/R2 keys live in engines/g3/config/g3.env (see docs/keys.md).
COMPANY_CORE_WORKSPACE_ROOT=.
MARKETING_G3_ROOT=engines/g3
MARKETING_G3_BIN=engines/g3/.venv/bin/company-core-g3
MARKETING_G3_ENV_FILE=engines/g3/config/g3.env
MARKETING_STAGE_TIMEOUT=900

# Optional non-Buffer scheduler. Buffer remains the default. The webhook
# contract is documented in docs/publishers.md; the receiver must verify the
# X-Publisher-Signature HMAC and return JSON with a provider post id.
PUBLISHER_WEBHOOK_URL=
PUBLISHER_WEBHOOK_SECRET=
PUBLISHER_WEBHOOK_ACCOUNT=webhook
PUBLISHER_WEBHOOK_LABEL=Webhook scheduler
PUBLISHER_WEBHOOK_PLATFORMS=instagram,x,linkedin
PUBLISHER_WEBHOOK_TIMEOUT_SECONDS=30
PUBLISHER_WEBHOOK_ASSET_TTL_SECONDS=3600
# Public origin used for short-lived signed media links passed to a webhook
# scheduler. Must be reachable by the scheduler (not localhost in production).
PUBLIC_BASE_URL=http://localhost:8787
LORDICON_API_TOKEN=
OMNIROUTE_IMAGE_MODEL=

# Prospecting and enrichment providers (all optional).
# Where to get keys: see docs/keys.md. Practical minimum for first outreach is
# PROSPEO_API_KEY + one of PDL_API_KEY / CE_API_KEY. Verify with `make doctor`
# and the Sales Doctor in the UI; avoid force=true (spends credits).
HUNTER_API_KEY=
APOLLO_API_KEY=
PROSPEO_API_KEY=
LUSHA_API_KEY=
PDL_API_KEY=
CE_API_KEY=
COMPANY_ENRICH_WAIT_FOR_ENRICHMENT=true

# Outbound email and inbound reply tracking.
# Resend: verify a sending domain first, then SALES_FROM_EMAIL must use that
# domain. Webhook target: <public-URL>/integrations/resend/sales. See docs/keys.md.
SALES_RESEND_API_KEY=
SALES_RESEND_DOMAIN=example.com
SALES_FROM_NAME=Example Company
SALES_FROM_EMAIL=sales@example.com
SALES_REPLY_TO_EMAIL=sales@example.com
SALES_RESEND_WEBHOOK_SECRET=
SALES_AUTO_CONTACT_ENABLED=false
SALES_AUTO_CONTACT_SOURCES=website,popup_offer,quiz_funnel,post_form,social_form

# Forms, attribution, and scheduling
MARKETING_CTA_URL=https://forms.example.com
MARKETING_POPUP_OFFER=operations checklist
MARKETING_FORMS_BASE_URL=https://forms.example.com
TALLY_API_KEY=
TALLY_WEBHOOK_SECRET=
SALES_PUBLIC_BASE_URL=http://localhost:8787
SALES_SCHEDULE_URL=http://localhost:8787/meet
SALES_CALENDAR_BASE_URL=http://localhost:3000
SALES_CALENDAR_EVENT_PATH=book/company
SALES_CALENDAR_BOOKING_URL=
SALES_CALENDAR_EMBED_URL=

# Legacy inbox relay is disabled unless both values are supplied.
SALES_INBOX_URL=
SALES_INBOX_TOKEN=
